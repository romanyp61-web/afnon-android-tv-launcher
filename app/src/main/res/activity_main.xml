<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_navy"
    android:padding="24dp">

    <!-- الجزء العلوي: العنوان والساعة -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_alignParentTop="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_white"
            android:textSize="28sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/clock_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1:35 ص"
            android:textColor="@color/text_white"
            android:textSize="32sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- شريط الفوتر السفلي (الآية والأسماء) -->
    <LinearLayout
        android:id="@+id/footer_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/card_bg"
        android:gravity="center"
        android:padding="12dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/footer_verse"
            android:textColor="@color/accent_gold"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />
    </LinearLayout>

    <!-- المحتوى الوسطي (الاختصارات والبرامج) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header_layout"
        android:layout_above="@id/footer_layout"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تطبيقات وبرامج أجبية TV"
            android:textColor="@color/accent_gold"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- صف الاختصارات والتطبيقات -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:layout_width="140dp"
                android:layout_height="60dp"
                android:text="يوتيوب"
                android:textColor="@color/text_white"
                android:backgroundTint="@color/card_bg"
                android:layout_margin="8dp" />

            <Button
                android:layout_width="140dp"
                android:layout_height="60dp"
                android:text="شاهد"
                android:textColor="@color/text_white"
                android:backgroundTint="@color/card_bg"
                android:layout_margin="8dp" />

            <Button
                android:layout_width="140dp"
                android:layout_height="60dp"
                android:text="الكتاب المقدس"
                android:textColor="@color/text_white"
                android:backgroundTint="@color/card_bg"
                android:layout_margin="8dp" />

            <Button
                android:layout_width="140dp"
                android:layout_height="60dp"
                android:text="المتصفح"
                android:textColor="@color/text_white"
                android:backgroundTint="@color/card_bg"
                android:layout_margin="8dp" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
